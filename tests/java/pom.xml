<?xml version="1.0" encoding="UTF-8"?>
<!-- Endive integration tests for the wasip1 reactor; build it first (see CONTRIBUTING.md). -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.strands.shell</groupId>
  <artifactId>strands-shell-wasm-tests</artifactId>
  <version>0.0.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <endive.version>1.1.0</endive.version>
    <junit.version>5.14.4</junit.version>
    <strands.shell.wasm>${project.basedir}/../../target/wasm32-wasip1/release/strands_shell.wasm</strands.shell.wasm>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>run.endive</groupId>
        <artifactId>bom</artifactId>
        <version>${endive.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- Needed by the generated module class, which lives in main sources. -->
    <dependency>
      <groupId>run.endive</groupId>
      <artifactId>runtime</artifactId>
    </dependency>
    <dependency>
      <groupId>run.endive</groupId>
      <artifactId>wasi</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>run.endive</groupId>
        <artifactId>endive-compiler-maven-plugin</artifactId>
        <version>${endive.version}</version>
        <executions>
          <execution>
            <id>compile-shell</id>
            <goals>
              <goal>compile</goal>
            </goals>
            <configuration>
              <wasmFile>${strands.shell.wasm}</wasmFile>
              <name>com.strands.shell.wasm.StrandsShellModule</name>
              <moduleInterface>com.strands.shell.wasm.StrandsShell</moduleInterface>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.14.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.3</version>
      </plugin>
    </plugins>
  </build>
</project>
